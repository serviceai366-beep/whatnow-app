# Server-only secret. Never expose it through a NEXT_PUBLIC_* variable.
OPENAI_API_KEY=replace-with-your-server-side-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Public widget key. The matching secret must remain server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-your-server-side-turnstile-secret
TURNSTILE_EXPECTED_HOSTNAME=whatnow-app.com,whatnow-app.timurka-0701.chatgpt.site
# Optional values can only tighten these safe maxima, never raise them.
WHATNOW_USER_24H_LIMIT=3
WHATNOW_USER_7D_LIMIT=10
WHATNOW_GLOBAL_24H_LIMIT=30
WHATNOW_GLOBAL_24H_COST_UNITS=60
# Keep reminders closed to the confirmed owner until a custom sending domain is verified.
WHATNOW_REMINDER_MODE=pilot
WHATNOW_REMINDER_PILOT_EMAIL=owner@example.com
